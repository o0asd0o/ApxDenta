{
  "extends": ["@repo/tsconfig/base.json"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "incremental": true,
    "composite": true,
    "verbatimModuleSyntax": false,
    "outDir": "dist",
    "paths": {
      "@/*": ["./src/*"],
    }
  },
  "include": ["src/**/*"]
}
