generator client {
  provider     = "prisma-kysely"
  output       = "./out"
  enumFileName = "enums.ts"
  fileName     = "types.ts"
}

datasource db {
  provider = "postgresql"
  url      = env("SERVER_POSTGRES_URL")
}

model account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamp(0)
  refreshTokenExpiresAt DateTime? @db.Timestamp(0)
  scope                 String?
  password              String?
  createdAt             DateTime  @db.Timestamp(0)
  updatedAt             DateTime  @db.Timestamp(0)
  notes                 Note[]
  patients              Patient[]
  staffs                Staff[]
  user                  user      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model session {
  id                   String   @id
  expiresAt            DateTime @db.Timestamp(0)
  token                String   @unique
  createdAt            DateTime @db.Timestamp(0)
  updatedAt            DateTime @db.Timestamp(0)
  ipAddress            String?
  userAgent            String?
  userId               String
  activeOrganizationId String?
  user                 user     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model user {
  id            String       @id
  name          String
  email         String       @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime     @db.Timestamp(0)
  updatedAt     DateTime     @db.Timestamp(0)
  account       account[]
  invitation    invitation[]
  member        member[]
  session       session[]
}

model verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime  @db.Timestamp(0)
  createdAt  DateTime? @db.Timestamp(0)
  updatedAt  DateTime? @db.Timestamp(0)
}

model invitation {
  id             String       @id
  organizationId String
  email          String
  role           String?
  status         String
  expiresAt      DateTime     @db.Timestamp(0)
  inviterId      String
  user           user         @relation(fields: [inviterId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  organization   organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model member {
  id             String       @id
  organizationId String
  userId         String
  role           String
  createdAt      DateTime     @db.Timestamp(0)
  organization   organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user           user         @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model organization {
  id               String            @id
  name             String
  slug             String            @unique
  logo             String?
  createdAt        DateTime          @db.Timestamp(0)
  metadata         String?
  address          String?
  lat              Int?
  long             Int?
  slogan           String
  assets           Asset[]
  assetTransfers   AssetTransfer[]
  billHistory      BillHistory[]
  cosmeticServices CosmeticService[]
  medicalServices  MedicalService[]
  patients         Patient[]
  peripherals      Peripheral[]
  reservations     Reservation[]
  staffs           Staff[]
  stocks           Stock[]
  treatments       Treatment[]
  vendors          Vendor[]
  invitation       invitation[]
  member           member[]
}

model Staff {
  id                   String             @id @default(dbgenerated("gen_random_uuid()"))
  type                 StaffType
  accountId            String?
  address              String?
  contactNumber        String
  createdAt            DateTime           @default(now())
  employmentType       EmploymentType
  firstName            String
  lastName             String
  lat                  Float?
  long                 Float?
  position             String
  specialistsRecordId  String?
  updatedAt            DateTime           @default(now())
  status               StaffStatus?       @default(ACTIVE)
  email                String?
  organizationId       String?
  avatarId             String?
  isArchived           Boolean?           @default(false)
  createdAssets        Asset[]
  createdAssetTransfer AssetTransfer[]
  processedBillHistory BillHistory[]
  createdPeripherals   Peripheral[]
  reservations         Reservation[]
  account              account?           @relation(fields: [accountId], references: [id])
  avatar               File?              @relation(fields: [avatarId], references: [id])
  organization         organization?      @relation(fields: [organizationId], references: [id])
  specialist           SpecialistsRecord? @relation(fields: [specialistsRecordId], references: [id])
  workingSchedules     WorkSchedule[]
  assignedTreatments   Treatment[]        @relation("StaffAssignedTreatment")
  daysOff              DayOff[]           @relation("StaffDayOff")

  emergencyContactNumber   String?
  emergencyContactName     String?
  emergencyContactRelation String?

  @@index([email, firstName, lastName], map: "idx_staff_email_first_last")
}

model DayOff {
  id        String    @id @default(dbgenerated("gen_random_uuid()"))
  name      String
  from      DateTime
  to        DateTime?
  repeat    Boolean?
  isDefault Boolean?
  staffs    Staff[]   @relation("StaffDayOff")
}

model WorkSchedule {
  id             String              @id @default(dbgenerated("gen_random_uuid()"))
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @default(now())
  day            WorkingDay
  staffId        String?
  from           DateTime            @db.Time(0)
  to             DateTime            @db.Time(0)
  staff          Staff?              @relation(fields: [staffId], references: [id])
  scheduleSlices WorkScheduleSlice[]
}

model WorkScheduleSlice {
  id             String        @id @default(dbgenerated("gen_random_uuid()"))
  workScheduleId String?
  from           DateTime      @db.Time(0)
  to             DateTime      @db.Time(0)
  workSchedule   WorkSchedule? @relation(fields: [workScheduleId], references: [id])
}

model SpecialistsRecord {
  id          String   @id @default(dbgenerated("gen_random_uuid()"))
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())
  title       String
  description String?
  code        String
  staffs      Staff[]
}

model Treatment {
  id               String               @id @default(dbgenerated("gen_random_uuid()"))
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @default(now())
  name             String
  category         TreatmentCategory
  isArchived       Boolean              @default(false)
  description      String               @default("")
  visitType        TreatmentVisitType
  duration         Float
  pricePerDuration Float
  status           TreatmentStatus      @default(FINALIZED)
  unit             String?
  organizationId   String?
  cosmeticServices CosmeticService[]
  medicalServices  MedicalService[]
  ratings          Rating[]
  reservations     Reservation[]
  reviews          Review[]
  organization     organization?        @relation(fields: [organizationId], references: [id])
  components       TreatmentComponent[]
  visits           TreatmentVisit[]

  visitTreatment TreatmentVisit[] @relation("VisitTreatment")
  staffsAssigned Staff[]          @relation("StaffAssignedTreatment")

  @@index([name, category, visitType], map: "idx_treatment_name_category_visitType")
}

model TreatmentComponent {
  id                 String           @id @default(dbgenerated("gen_random_uuid()"))
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @default(now())
  medicalComponentId String
  quantity           Int
  treatmentId        String?
  free               Boolean?
  freeUpTo           Int?
  component          MedicalComponent @relation(fields: [medicalComponentId], references: [id])
  treatment          Treatment?       @relation(fields: [treatmentId], references: [id])
}

model MedicalComponent {
  id                  String               @id @default(dbgenerated("gen_random_uuid()"))
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @default(now())
  name                String
  price               Float
  organizationId      String?
  treatmentComponents TreatmentComponent[]
}

model TreatmentVisit {
  id String @id @default(dbgenerated("gen_random_uuid()"))

  sequence        Int
  gracePeriod     Int?
  gracePeriodUnit GracePeriodUnit?

  visitTreatment   Treatment? @relation(fields: [visitTreatmentId], references: [id], name: "VisitTreatment")
  visitTreatmentId String?

  treatment   Treatment? @relation(fields: [treatmentId], references: [id])
  treatmentId String?

  @@index([treatmentId], map: "idx_treatment_visit_treatment_id")
}

model Review {
  id          String     @id @default(dbgenerated("gen_random_uuid()"))
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @default(now())
  description String
  treatmentId String?
  images      File[]
  treatment   Treatment? @relation(fields: [treatmentId], references: [id])

  @@index([treatmentId], map: "idx_review_treatment_id")
}

model Note {
  id          String   @id @default(dbgenerated("gen_random_uuid()"))
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())
  description String
  accountId   String
  imageId     String?
  createdBy   account  @relation(fields: [accountId], references: [id])
  image       File?    @relation(fields: [imageId], references: [id])
}

model File {
  id            String       @id @default(dbgenerated("gen_random_uuid()"))
  url           String
  name          String
  thumb         String?
  fallback      String?
  type          String
  size          Float
  reservationId String?
  reviewId      String?
  reservation   Reservation? @relation(fields: [reservationId], references: [id])
  review        Review?      @relation(fields: [reviewId], references: [id])
  notes         Note[]
  peripherals   Peripheral[]
  staffs        Staff[]
  stocks        Stock[]
}

model Rating {
  id          String     @id @default(dbgenerated("gen_random_uuid()"))
  rate        Float
  remark      String?
  treatmentId String?
  createdAt   DateTime   @default(now())
  treatment   Treatment? @relation(fields: [treatmentId], references: [id])

  @@index([treatmentId], map: "idx_rating_treatment_id")
}

model Patient {
  id                        String                    @id @default(dbgenerated("gen_random_uuid()"))
  accountId                 String?
  address                   String
  age                       Int
  createdAt                 DateTime                  @default(now())
  dentalCareStart           DentalCareStart
  email                     String                    @unique
  firstName                 String
  gender                    Gender
  lastDentalVisit           LastDetalVisit
  lastName                  String
  status                    PatientStatus             @default(NEW)
  lat                       Float?
  long                      Float?
  oralHygieneDuration       OralHygienDuration
  phoneNumber               String
  updatedAt                 DateTime                  @default(now())
  usingDentalFloss          Boolean
  washTeethFrequency        WashTeethFrequency
  changeToothBrushFrequency ChangeToothBrushFrequency
  organizationId            String?
  billHistory               BillHistory[]
  medicalCheckups           MedicalCheckup[]
  account                   account?                  @relation(fields: [accountId], references: [id])
  organization              organization?             @relation(fields: [organizationId], references: [id])
  reservations              Reservation[]
}

model Reservation {
  id                 String            @id @default(dbgenerated("gen_random_uuid()"))
  createdAt          DateTime          @default(now())
  note               String?
  status             ReservationStatus
  isArchived         Boolean           @default(false)
  staffId            String
  patientId          String
  initialTreatmentId String
  organizationId     String?
  bills              Bill[]
  billsHistory       BillHistory[]
  attachments        File[]
  medicalCheckups    MedicalCheckup[]
  initialTreatment   Treatment         @relation(fields: [initialTreatmentId], references: [id])
  organization       organization?     @relation(fields: [organizationId], references: [id])
  patient            Patient           @relation(fields: [patientId], references: [id])
  doctor             Staff             @relation(fields: [staffId], references: [id])
}

model MedicalCheckup {
  id                 String               @id @default(dbgenerated("gen_random_uuid()"))
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @default(now())
  status             MedicalCheckupStatus
  bloodPressureMm    Int
  bloodPressureHg    Int
  particularSickness String[]
  allergies          String[]
  occlusi            Occlusi
  torusPalatinus     TorusPalatinus
  torusMandibularis  OralSide
  palatum            OralSide
  diastema           String
  anomalous          String
  othersNotListed    String?
  reservationId      String?
  patientRefId       String?
  cosmeticServuces   CosmeticService[]
  patientRef         Patient?             @relation(fields: [patientRefId], references: [id])
  reservationRef     Reservation?         @relation(fields: [reservationId], references: [id])
  medicalServices    MedicalService[]
}

model CosmeticService {
  id               String          @id @default(dbgenerated("gen_random_uuid()"))
  condition        String?
  maxilla          Boolean?
  mandible         Boolean?
  treatmentId      String
  approved         Boolean         @default(false)
  unapprovedReason String?
  medicalCheckupId String?
  organizationId   String?
  medicalCheckup   MedicalCheckup? @relation(fields: [medicalCheckupId], references: [id])
  organization     organization?   @relation(fields: [organizationId], references: [id])
  treatment        Treatment       @relation(fields: [treatmentId], references: [id])
}

model MedicalService {
  id               String               @id @default(dbgenerated("gen_random_uuid()"))
  toothNumber      Int?
  note             String?
  status           MedicalServiceStatus
  approved         Boolean
  unapprovedReason String?
  medicalCheckupId String?
  treatmentId      String
  toothConditionId String
  organizationId   String?
  medicalCheckup   MedicalCheckup?      @relation(fields: [medicalCheckupId], references: [id])
  organization     organization?        @relation(fields: [organizationId], references: [id])
  condition        ToothCondition       @relation(fields: [toothConditionId], references: [id])
  treatment        Treatment            @relation(fields: [treatmentId], references: [id])
}

model ToothCondition {
  id              String           @id @default(dbgenerated("gen_random_uuid()"))
  name            String
  code            String           @unique
  medicalServices MedicalService[]
}

model Vendor {
  id             String        @id @default(dbgenerated("gen_random_uuid()"))
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now())
  name           String
  shortName      String
  contactPerson  String
  contactNumber  String
  email          String
  address        String
  lat            Float?
  long           Float?
  organizationId String?
  Peripheral     Peripheral[]
  organization   organization? @relation(fields: [organizationId], references: [id])
  stock          Stock[]       @relation("VendorStock")
}

model Stock {
  id             String        @id @default(dbgenerated("gen_random_uuid()"))
  category       StockCategory
  createdAt      DateTime      @default(now())
  fileId         String?
  name           String
  quantity       Int
  sku            String        @unique
  status         StockStatus
  unit           String?
  unitPrice      Float
  updatedAt      DateTime      @default(now())
  organizationId String?
  image          File?         @relation(fields: [fileId], references: [id])
  organization   organization? @relation(fields: [organizationId], references: [id])
  vendors        Vendor[]      @relation("VendorStock")
}

model Peripheral {
  id             String             @id @default(dbgenerated("gen_random_uuid()"))
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @default(now())
  fileId         String?
  weight         Float
  category       PeripheralCategory
  barcode        String
  purchaseDate   DateTime
  invoiceNumber  String
  price          Float
  quantity       Int
  vendorId       String
  sku            String             @unique
  name           String
  roomId         String
  staffId        String
  organizationId String?
  image          File?              @relation(fields: [fileId], references: [id])
  organization   organization?      @relation(fields: [organizationId], references: [id])
  assignedRoom   Room               @relation(fields: [roomId], references: [id])
  createdBy      Staff              @relation(fields: [staffId], references: [id])
  vendor         Vendor             @relation(fields: [vendorId], references: [id])
}

model Room {
  id          String       @id @default(dbgenerated("gen_random_uuid()"))
  name        String
  description String?
  peripherals Peripheral[]
}

model BillHistory {
  id                 String          @id @default(dbgenerated("gen_random_uuid()"))
  createdAt          DateTime        @default(now())
  billId             Int?
  type               BillHistoryType
  description        String?
  staffId            String?
  patientId          String?
  reservationId      String?
  organizationId     String?
  bill               Bill?           @relation(fields: [billId], references: [id])
  organization       organization?   @relation(fields: [organizationId], references: [id])
  processedByPatient Patient?        @relation(fields: [patientId], references: [id])
  reservation        Reservation?    @relation(fields: [reservationId], references: [id])
  processedByStaff   Staff?          @relation(fields: [staffId], references: [id])
}

model Bill {
  id            Int           @id @default(autoincrement())
  createdAt     DateTime      @default(now())
  assetId       String
  billType      BillType
  amount        Float
  status        BillStatus
  paymentType   PaymentType?
  reservationId String
  asset         Asset         @relation(fields: [assetId], references: [id])
  reservation   Reservation   @relation(fields: [reservationId], references: [id])
  billHistory   BillHistory[]
}

model AssetTransfer {
  id             String        @id @default(dbgenerated("gen_random_uuid()"))
  createdAt      DateTime      @default(now())
  amount         Float
  fromAssetId    String
  toAssetId      String
  note           String?
  staffId        String
  organizationId String?
  from           Asset         @relation("FromAsset", fields: [fromAssetId], references: [id])
  organization   organization? @relation(fields: [organizationId], references: [id])
  createdBy      Staff         @relation(fields: [staffId], references: [id])
  to             Asset         @relation("ToAsset", fields: [toAssetId], references: [id])
}

model Asset {
  id                 String          @id @default(dbgenerated("gen_random_uuid()"))
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @default(now())
  name               String
  description        String?
  isDefault          Boolean         @default(false)
  isActive           Boolean         @default(true)
  color              String
  icon               String
  currentAmount      Float
  staffId            String
  organizationId     String?
  organization       organization?   @relation(fields: [organizationId], references: [id])
  createdBy          Staff           @relation(fields: [staffId], references: [id])
  fromAssetTransfers AssetTransfer[] @relation("FromAsset")
  toAssetTransfers   AssetTransfer[] @relation("ToAsset")
  bills              Bill[]
}

enum PeripheralCategory {
  MAIN_EQUIPMENT
  SUPPORT_EQUIPMENT
  DIAGNOSTIC_EQUIPMENT
}

enum StockCategory {
  ANALGESIC
  ANTIACID
  ANTIANXIETY_DRUG
  ANTIARRHYTHMICS
  ANTISEPTIC
  ANTIBACTERIAL
  ANTIBIOTIC
  ANTICOGAGULANT
  THROMBOLYTICS
  ANTICONVULSANTS
  ANTIDEPRESANTS
  ANTIDIARRHEAL
  ANTIEMETICS
  ANTIFUNGAL
  ANTIHISTAMINE
  ANTIHYPERTENSIVE
  ANTI_INFLAMMATORY
  ANTINEOPLASTIC
  ANTIPSYCHOTIC
  ANTIPYRETIC
  ANTIVIRAL
  BARBITURE
  BETA_BLOCKER
  BRONCHODILATOR
  COLD_CURE
  CORTISOSTEROID
  STEROID
  COUGH_SUPRESSANT
  CYTOTOXIC
  DECONGESTANT
  EXPECTORANT
  DIURETIC
  HORMONES
  HYPOGLYCEMIC
  IMMUNOSUPPRESSIVE
  LAXATIVE
  MUSCLE_RELAXANT
  SEDATIVE
  SEX_HORMONE_FEMALE
  SEX_HORMONE_MALE
  SLEEPING_DRUG
  TRANQUILIZER
  VITAMIN
}

enum StockStatus {
  LOW_STOCK
  IN_STOCK
  OUT_OF_STOCK
}

enum StaffStatus {
  ACTIVE
  INACTIVE
  EXPIRED
  TERMINATED
  RESIGNED
  SUSPENDED
}

enum StaffType {
  DOCTOR
  STAFF
}

enum Gender {
  MALE
  FEMALE
}

enum EmploymentType {
  PART_TIME
  FULL_TIME
}

enum TreatmentCategory {
  MEDICAL_SERVICE
  COSMETIC_SERVICE
}

enum ReservationStatus {
  DONE
  CANCELLED
  PENDING
  NO_SHOW
  ENCOUNTER
}

enum TreatmentVisitType {
  MULTIPLE_VISIT
  SINGLE_VISIT
}

enum MedicalServiceStatus {
  DONE
  PENDING
}

enum WorkingDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum BillType {
  RESERVATION_FEE
  TREATMENT_FEE
}

enum BillStatus {
  UNPAID
  PAID
}

enum PaymentType {
  CASH
  E_WALLET
  BANK_TRANSFER
}

enum VisitStatus {
  DEFAULT
  CANCELLED
}

enum TreatmentStatus {
  SAMPLE
  FINALIZED
  INACTIVE
}

enum OralHygienDuration {
  AROUND_1_MINUTE
  ABOUNT_2_MINUTES
  MORE_THAN_2_MINUTES
  I_DONT_KNOW
}

enum ChangeToothBrushFrequency {
  EVERY_3_MONTHS
  EVERY_6_MONTHS
  EVERY_YEAR
  AS_OCCUR
}

enum OralSide {
  NO
  LEFT
  RIGHT
  BOTH
}

enum TorusPalatinus {
  NO
  SMALL
  MEDIUM
  LARGE
  MULTIPLE
}

enum Occlusi {
  NORMAL
  CROSS
  STEEP
}

enum WashTeethFrequency {
  NEVER
  ONCE
  TWICE
  THRICE
  MORE_THAN_THRICE
}

enum DentalCareStart {
  TEENAGER
  ABOUT_20
  ABOUT_30
  AFTER_30
}

enum LastDetalVisit {
  LESS_THAN_3_MONTHS
  LESS_THAN_6_MONTHS
  A_YEAR_AGO
  DONT_REMEMBER
}

enum PatientStatus {
  NEW
  ACTIVE
  INACTIVE
}

enum MedicalCheckupStatus {
  ARCHIVED
  LATEST
}

enum BillHistoryType {
  COMMENT
  PAYMENT
}

enum GracePeriodUnit {
  DAYS
  WEEKS
  MONTHS
}
