{
  "extends": "@repo/tsconfig/react-library.json",
  "compilerOptions": {
    "strict": true,
    "target": "ESNext",
    "outDir": "dist",
    "module": "ESNext",
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "jsx": "react",
    "baseUrl": "src",
  }
}
