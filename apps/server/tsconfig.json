{
  "extends": ["@repo/tsconfig/base.json"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "verbatimModuleSyntax": false,
    "incremental": true,
    "composite": true,
    "outDir": "dist",
    "paths": {
      "@/*": ["./src/*"],
      "~/lib/*": ["./lib/*"],
      "~/prisma/*": ["./prisma/*"],
    }
  },
  "include": ["src/**/*", "lib", "prisma"],
  "references": [
      {
         "path": "../../packages/domain"
      }
   ]
}
