{
  "name": "@repo/server",
  "scripts": {
    "dev": "dotenv -e .env.local -- bun run --hot src/index.ts --ignore-warnings",
    "start": "bun run dist/src/index.js --ignore-warnings",
    "dev:migrate": "dotenv -e .env.local -- bunx  @better-auth/cli migrate",
    "build": "tsc -b",
    "build:dev": "tsc -b",
    "prisma:generate": "dotenv -e .env.local -- prisma generate",
    "prisma:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "prisma:introspect": "dotenv -e .env.local -- prisma introspect",
    "prisma:studio": "dotenv -e .env.local -- prisma studio",
    "ts-compile": "tsx --build --verbose"
  },
  "dependencies": {
    "@hono/trpc-server": "^0.3.4",
    "@hono/zod-openapi": "^0.18.3",
    "@repo/domain": "workspace:*",
    "@trpc/server": "^11.0.4",
    "better-auth": "^1.2.12",
    "hono": "^4.6.19",
    "hono-rate-limiter": "^0.4.2",
    "kysely": "^0.28.2",
    "pg": "^8.13.1",
    "prisma-kysely": "^1.8.0",
    "resend": "^4.6.0",
    "superjson": "^2.2.2",
    "trpc-playground": "^1.0.4",
    "uuid": "^11.1.0",
    "valibot": "^1.0.0",
    "zod": "^3.25.51"
  },
  "devDependencies": {
    "dotenv-cli": "^7.3.0",
    "@types/bun": "latest",
    "@types/pg": "^8.11.11",
    "@better-auth/cli": "^1.1.15",
    "prisma": "^6.3.0",
    "@repo/tsconfig": "workspace:*",
    "@types/react": "^18.2.21",
    "tsx": "^4.19.1",
    "typescript": "^5.8.3"
  }
}
