{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "ui": "tui",
  "tasks": {
    "build": {
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "dependsOn": ["^build"]
    },
    "build-backend": {
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "dependsOn": ["^build-backend"]
    },
    "build:dev": {
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "dependsOn": ["^build:dev"]
    },
    "start": {
      "dependsOn": ["^build"]
    },
    "test:ui": {
      "persistent": true
    },
    "lint": {
      "cache": false
    },
    "lint:fix": {
      "cache": false
    },
    "ui:add": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lib_dev": { "outputs": ["dist/**"] },
    "clean": {
      "cache": false
    }
  }
}
